# Copy this file to .env and fill in real values before production use.
# In development, sensible defaults are used for anything left blank
# (see server/src/config/env.js) EXCEPT in NODE_ENV=production, where
# missing required secrets cause startup to fail loudly instead of
# silently running insecure.

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:4000

# --- Session security -------------------------------------------------
# Long random string used to... (kept for future HMAC-based features;
# sessions themselves are opaque server-side tokens, see lib/tokens.js)
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=12

# --- VIT email enforcement ---------------------------------------------
# Comma-separated list of domains allowed to register/login.
VIT_EMAIL_DOMAINS=vitstudent.ac.in

# --- OTP / verification -------------------------------------------------
OTP_TTL_MINUTES=10
OTP_LENGTH=6

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_LOGIN=8
RATE_LIMIT_MAX_OTP=5
RATE_LIMIT_MAX_REGISTER=5
# Content-creation limits — protect against a single account spamming.
RATE_LIMIT_MAX_POST_CREATE=15
RATE_LIMIT_MAX_COMMENT_CREATE=30
RATE_LIMIT_MAX_REPORT_SUBMIT=10
RATE_LIMIT_MAX_REVIEW_SUBMIT=10
RATE_LIMIT_MAX_NOTE_UPLOAD=10

# --- Database -------------------------------------------------------------
# Postgres connection string (Neon, Supabase, Render Postgres, etc). Required
# in production — the app uses Postgres, not the local SQLite file.
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# DB_PATH is unused now (legacy SQLite-era setting, kept only so old .env
# files don't break); safe to delete this line.
DB_PATH=./data/vaccess.db

# --- Email service (see server/src/lib/email.js) --------------------------
# transport=console (default): prints emails to the server log, no setup
# needed. Use this for local development and demos.
# transport=smtp: set the SMTP_* values and implement sendViaSmtp() in
# lib/email.js with your SMTP client of choice (provider not specified by
# the SRS — see TBD list).
EMAIL_TRANSPORT=console
EMAIL_FROM=no-reply@vaccess.vit.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Live campus map (Find My Class) ---------------------------------
# No config needed — the live map uses OpenStreetMap's own embed endpoint
# directly (no API key required). Coordinates are per-zone data
# (campus_locations.latitude/longitude), set via the admin UI, not env vars.

# --- File storage abstraction (Notes Hub module, later stage) -------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads

# --- Default admin bootstrap (optional, first run only) -------------------
# If both are set, an admin account is created on first boot if it does not
# already exist. Leave blank to skip. See README "Default admin setup".
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
